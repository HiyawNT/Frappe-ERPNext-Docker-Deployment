# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` to version control.

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# Registry/repo for your custom-built Frappe/ERPNext image.
FRAPPE_IMAGE=hiyawn/lh-stagging
# Pinned, immutable tag (e.g. a git SHA or release tag from your CI build).
# Required — compose will fail to start if this is unset.
IMAGE_TAG=admission-implementation

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
# Strong password — this is root access to MariaDB. Generate with e.g.
# `openssl rand -base64 32`
MYSQL_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# ---------------------------------------------------------------------------
# Socket.IO
# ---------------------------------------------------------------------------
SOCKETIO_PORT=9000

# ---------------------------------------------------------------------------
# Resource limits (override the defaults baked into docker-compose.yml)
# Format: mem values like "512m" / "2g", cpus as a decimal number of cores.
# ---------------------------------------------------------------------------
BACKEND_MEM_LIMIT=2g
BACKEND_MEM_RESERVATION=1g
BACKEND_CPUS=1.5

SETUP_MEM_LIMIT=512m
SETUP_CPUS=0.5

WEBSOCKET_MEM_LIMIT=512m
WEBSOCKET_MEM_RESERVATION=256m
WEBSOCKET_CPUS=0.5

FRONTEND_MEM_LIMIT=512m
FRONTEND_CPUS=0.5

QUEUE_SHORT_MEM_LIMIT=1g
QUEUE_SHORT_MEM_RESERVATION=512m
QUEUE_SHORT_CPUS=1

QUEUE_LONG_MEM_LIMIT=1g
QUEUE_LONG_MEM_RESERVATION=512m
QUEUE_LONG_CPUS=1

SCHEDULER_MEM_LIMIT=512m
SCHEDULER_CPUS=0.5

DB_MEM_LIMIT=2g
DB_MEM_RESERVATION=1g
DB_CPUS=2

REDIS_CACHE_MEM_LIMIT=256m
REDIS_CACHE_CPUS=0.5

REDIS_QUEUE_MEM_LIMIT=256m
REDIS_QUEUE_CPUS=0.5
